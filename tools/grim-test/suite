]
# Tests that toggle many modules at once; Grim's opinion of them isn't part of the result.
FLAGS_IGNORED = {"selftest (every module)"}


def main():
    args = sys.argv[1:]
    if args == ["--list"]:
        for name, _ in TESTS: print(name)
        return
    if "no dev client" in client("echo ping", timeout=10):
        sys.exit("no dev client running (see README)")
    chosen = [(n, f) for n, f in TESTS if not args or any(a in n for a in args)]
    results = []
    for name, test in chosen:
        sh("flags", "mark")
        start = time.time()
        try:
            ok, detail = test()
        except Exception as e:
            ok, detail = False, f"error: {e}"
        flags = sh("flags")
        flagged = sorted(set(re.findall(r"failed (\w+)", flags)))
        if flagged and name not in FLAGS_IGNORED: ok = False
        results.append((name, ok, detail, flagged, time.time() - start))
        print(f"{'PASS' if ok else 'FAIL'}  {name:<30} {detail}" + (f"  [flags: {', '.join(flagged)}]" if flagged else ""), flush=True)
    failed = [r for r in results if not r[1]]
    print(f"\n{len(results) - len(failed)}/{len(results)} passed")
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
