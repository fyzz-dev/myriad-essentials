#!/usr/bin/env python3
"""Runs the Essentials test suite against the local Grim server and the dev client, and prints a table.

  ./suite              every test
  ./suite kill_aura    tests whose name contains any of the words given
  ./suite --list       the tests

Needs the server (./start.sh) and the dev client in game as GrimTester (op). Each test sets up its own scene (most of
them on a stone floor around x=1000 so they don't touch the rest of the world), runs client steps, then checks the
result on the server and that Grim flagged nothing. Exit code 1 if anything failed.
"""
import math, os, re, subprocess, sys, time

HERE = os.path.dirname(os.path.abspath(__file__))
P = "GrimTester"
# The test floor: stone at y=99, air above, around x=1000 z=0.
ARENA = ["fill 980 99 -20 1040 99 20 stone", "fill 980 100 -20 1040 115 20 air"]


def sh(*args, timeout=180):
    r = subprocess.run([os.path.join(HERE, args[0]), *args[1:]], capture_output=True, text=True, timeout=timeout)
    return r.stdout + r.stderr


def cmd(*commands):
    return sh("cmd", *commands)


def client(*steps, timeout=120):
    return sh("client", "--timeout", str(timeout), *steps, timeout=timeout + 30)


def passed(condition):
    """Runs an execute if/unless test on the server."""
    return "passed" in cmd("execute " + condition)


def data(path):
    out = cmd(f"data get entity {P} {path}")
    m = re.search(r"entity data: (.*)", out)
    return m.group(1).strip() if m else ""


def count(slot):
    """The item count in an inventory slot number as the server stores it (0-8 hotbar, 9-35 main, -106 off hand)."""
    m = re.search(r"count: (\d+)", data(f"Inventory[{{Slot:{slot}b}}]"))
    return int(m.group(1)) if m else 0


def item(slot):
    m = re.search(r'id: "([^"]+)"', data(f"Inventory[{{Slot:{slot}b}}]"))
    return m.group(1) if m else ""


def position():
    nums = re.findall(r"(-?[\d.]+)d", data("Pos"))
    return tuple(float(n) for n in nums[:3]) if len(nums) >= 3 else (0, 0, 0)


def reset(x=1000.5, y=100, z=0.5, yaw=-90, pitch=0, arena=True):
    client("respawn", ".panic", "wait 20")
    # The server only changes loaded chunks: go there first, then build, then stand on it.
    cmd(f"gamemode survival {P}", f"tp {P} {x} {y + 30} {z} {yaw} {pitch}", f"effect give {P} slow_falling 3 0 true")
    time.sleep(1.5)
    cmd(*(ARENA if arena else []), f"clear {P}", f"effect clear {P}", f"kill @e[type=!player,distance=..64,x={x},y={y},z={z}]",
        f"tp {P} {x} {y} {z} {yaw} {pitch}", f"effect give {P} saturation 1 20 true")
    time.sleep(1.5)
    # Grim's opinion of the setup (teleports, slow falling) isn't the module's: count flags from here.
    sh("flags", "mark")


# ---- tests: each returns (ok, detail) -----------------------------------------------------------------------------------

def t_anticheat():
    out = client(".anticheat")
    return "Grim detected" in out, out.strip().splitlines()[-1] if out.strip() else "no output"


def t_selftest():
    # Looking down at the floor, with a bedrock hole and an obsidian crystal base nearby for the helpers to find.
    reset(pitch=30)
    cmd(f"item replace entity {P} hotbar.0 with diamond_sword", f"item replace entity {P} inventory.0 with totem_of_undying",
        f"item replace entity {P} hotbar.8 with cooked_beef 16", "setblock 1005 99 4 bedrock", "fill 1004 100 4 1006 100 4 bedrock",
        "setblock 1005 100 3 bedrock", "setblock 1005 100 5 bedrock", "setblock 1005 100 4 air", "setblock 1002 100 -3 obsidian")
    time.sleep(1)
    out = client("selftest 20 -auto_disconnect", timeout=600)
    m = re.search(r"selftest: (\d+) modules run, (\d+) failures", out)
    fails = [l.split("FAIL ", 1)[1] for l in out.splitlines() if "selftest: FAIL" in l]
    helpers = next((l.split("helpers: ", 1)[1] for l in out.splitlines() if "selftest: helpers:" in l), "")
    if not m:
        return False, "no selftest report"
    h = re.search(r"(\d+) holes, (\d+) crystal bases, snowball lands \(([-\d.]+), ([-\d.]+), ([-\d.]+)\)", helpers)
    helpers_ok = bool(h) and int(h.group(1)) >= 1 and int(h.group(2)) >= 1 and abs(float(h.group(4)) - 100) < 0.01
    return int(m.group(2)) == 0 and helpers_ok, f"{m.group(1)} modules, {m.group(2)} failures" + ("; " + "; ".join(fails[:3]) if fails else "") \
        + (f" | helpers{'' if helpers_ok else ' WRONG'}: {helpers}" if helpers else "")


def t_kill_aura_holding():
    reset()
    cmd(f"item replace entity {P} hotbar.0 with diamond_sword", "summon husk 1003.5 100 0.5 {NoAI:1b,Health:10f,Tags:[\"suite\"]}")
    time.sleep(0.5)
    client("select 1", ".set kill_aura weapon holding", ".toggle kill_aura on", "wait 60", ".toggle kill_aura off")
    return passed("unless entity @e[tag=suite]"), "husk killed with the held sword"


def t_kill_aura_switch():
    reset()
    cmd(f"item replace entity {P} inventory.4 with diamond_sword", f"item replace entity {P} hotbar.0 with dirt 16",
        "summon husk 1003.5 100 0.5 {NoAI:1b,Health:10f,Tags:[\"suite\"]}")
    time.sleep(0.5)
    out = client("select 1", ".set kill_aura weapon switch", ".toggle kill_aura on", "wait 80", "status", ".toggle kill_aura off", "wait 30", ".set kill_aura weapon holding")
    shown = re.search(r"item=(\S+)", out)
    killed = passed("unless entity @e[tag=suite]")
    back = item(13) == "minecraft:diamond_sword"
    return killed and back and shown and shown.group(1).endswith("dirt"), f"killed={killed}, hand showed {shown.group(1) if shown else '?'}, sword back in inventory={back}"


def t_packet_mine():
    reset()
    cmd("setblock 1003 100 0 deepslate", f"item replace entity {P} hotbar.0 with netherite_pickaxe", f"item replace entity {P} hotbar.1 with dirt 16")
    # Eyes at (1000.5, 101.62, 0.5) to the block's centre (1003.5, 100.5, 0.5).
    client("select 2", ".toggle packet_mine on", "look -90 20.47", "wait 2", "attack", "wait 40", ".toggle packet_mine off")
    return passed("if block 1003 100 0 air"), "deepslate mined with the pickaxe from another slot"


def t_scaffold():
    reset(z=-10.5, yaw=0)
    cmd("fill 980 99 -8 1040 99 20 air", f"item replace entity {P} hotbar.0 with dirt 64")
    # The test server's Grim checks where you look when placing (RotationPlace); 2b2t's doesn't.
    out = client("select 1", ".set scaffold rotate true", ".toggle scaffold on", "wait 2", "hold forward,sprint 30", "wait 32", "status", ".toggle scaffold off", ".set scaffold rotate false")
    # Every block it walked over from the floor's edge (z=-8), however far it got (Rotate breaks sprint at each one).
    _, y, z = position()
    path = range(-7, math.floor(z) + 1)
    placed = sum(passed(f"if block 1000 99 {bz} dirt") for bz in path)
    return len(path) >= 4 and placed == len(path) and y >= 99.9, f"{placed}/{len(path)} blocks bridged under the path, y={y:.2f}"


def t_offhand():
    reset()
    cmd(f"item replace entity {P} inventory.5 with totem_of_undying")
    client(".toggle offhand on", "wait 20", ".toggle offhand off")
    return item(-106) == "minecraft:totem_of_undying", f"off hand holds {item(-106) or 'nothing'}"


def t_auto_armor():
    reset()
    cmd(*(f"item replace entity {P} inventory.{i} with diamond_{p}" for i, p in enumerate(["helmet", "chestplate", "leggings", "boots"])))
    client(".toggle auto_armor on", "wait 40", ".toggle auto_armor off")
    worn = [item(s) for s in (100, 101, 102, 103)]
    return all(w.startswith("minecraft:diamond_") for w in worn), "worn: " + ", ".join(w.removeprefix("minecraft:") or "-" for w in worn)


def food():
    m = re.search(r"(\d+)", data("foodLevel"))
    return int(m.group(1)) if m else -1


def t_auto_eat():
    reset()
    cmd(f"item replace entity {P} hotbar.8 with cooked_beef 16", f"effect clear {P}")
    # Hunger in short strong bursts until the food bar is low (a very high amplifier overflows into healing).
    for _ in range(20):
        if 0 <= food() <= 5: break
        cmd(f"effect give {P} hunger 1 100 true")
        time.sleep(1.2)
    before = food()
    client(".toggle auto_eat on", "wait 120", ".toggle auto_eat off", timeout=60)
    left, after = count(8), food()
    return left < 16 and after > before, f"food {before} -> {after}, {16 - left} eaten"


def t_auto_eat_choice():
    # Low health: the enchanted golden apple, even from the main inventory, over a golden apple and golden carrots.
    # Hunger: golden carrots from the main inventory, keeping the golden apples.
    reset()
    cmd(f"item replace entity {P} hotbar.0 with golden_carrot 8", f"item replace entity {P} hotbar.1 with golden_apple 8",
        f"item replace entity {P} inventory.11 with enchanted_golden_apple 4", f"damage {P} 12")
    client(".set auto_eat health true", ".set auto_eat health_threshold 10", ".toggle auto_eat on", "wait 80", ".toggle auto_eat off", "wait 30", timeout=60)
    egap, apples, carrots = count(20), count(1), count(0)
    health_ok = egap == 3 and apples == 8 and carrots == 8
    reset()
    cmd(f"item replace entity {P} hotbar.1 with golden_apple 8", f"item replace entity {P} inventory.10 with golden_carrot 8", f"effect clear {P}")
    for _ in range(20):
        if 0 <= food() <= 12: break
        cmd(f"effect give {P} hunger 1 100 true")
        time.sleep(1.2)
    client(".toggle auto_eat on", "wait 80", ".toggle auto_eat off", "wait 30", timeout=60)
    hunger_ok = count(19) < 8 and count(1) == 8
    return health_ok and hunger_ok, (f"low health ate {4 - egap} enchanted from the inventory, {8 - apples} golden apples, {8 - carrots} carrots; "
        f"hungry ate {8 - count(19)} carrots from the inventory, {8 - count(1)} golden apples")


def t_stack_replenish():
    reset()
    cmd(f"item replace entity {P} hotbar.0 with cobblestone 1", f"item replace entity {P} inventory.0 with cobblestone 64")
    client(".toggle stack_replenish on", "wait 30", ".toggle stack_replenish off")
    return count(0) > 1, f"hotbar stack now {count(0)}"


def t_elytra_altitude():
    client("respawn", ".panic", "wait 20")
    cmd(f"clear {P}", f"gamemode survival {P}", f"item replace entity {P} armor.chest with elytra", f"tp {P} 2000.5 230 0.5 -90 0")
    time.sleep(1.5)
    sh("flags", "mark")
    x0 = position()[0]
    client(".set elytra_fly mode altitude", ".toggle elytra_fly on", "wait 200", ".toggle elytra_fly off", timeout=90)
    x, y, _ = position()
    wear = re.search(r"damage\"?: (\d+)", data("Inventory[{Slot:102b}]"))
    return x - x0 > 60 and y > 150, f"{x - x0:.0f} blocks in 10 s, y={y:.0f}, elytra damage {wear.group(1) if wear else 0}"


def t_elytra_no_durability():
    client("respawn", ".panic", "wait 20")
    cmd(f"clear {P}", f"gamemode survival {P}", f"item replace entity {P} armor.chest with elytra", f"item replace entity {P} hotbar.1 with diamond_chestplate",
        f"tp {P} 3000.5 300 0.5 -90 0")
    time.sleep(1.5)
    sh("flags", "mark")
    client(".set elytra_tweaks no_durability true", ".toggle elytra_tweaks on", ".set elytra_fly mode altitude", ".toggle elytra_fly on", "wait 200",
        ".toggle elytra_fly off", ".toggle elytra_tweaks off", "wait 20", timeout=90)
    damage = elytra_damage()
    hp, x = health(), position()[0]
    return 0 <= damage <= 2 and hp > 0 and x > 3060, f"elytra damage {damage} after 10 s of flight, {x - 3000:.0f} blocks, health {hp:.0f}"


def health():
    m = re.search(r"([\d.]+)f", data("Health"))
    return float(m.group(1)) if m else 0


def t_elytra_no_durability_landing():
    # No Durability keeps the server from gliding you, so it counts every block you come down as a fall; gliding down
    # to the ground afterwards must not cost any of it.
    client("respawn", ".panic", "wait 20")
    # Force-loaded chunks take the fill without anyone there; then stand on the floor while setting up.
    cmd("forceload add 4990 -24 5400 24")
    time.sleep(1)
    cmd("fill 4990 150 -20 5400 150 20 stone", f"tp {P} 5000.5 151 10.5 -90 0", f"clear {P}", f"gamemode survival {P}", f"effect clear {P}",
        f"effect give {P} instant_health 1 5 true", f"item replace entity {P} armor.chest with elytra", f"item replace entity {P} hotbar.1 with diamond_chestplate")
    client(".set elytra_tweaks no_durability true", ".set elytra_fly mode altitude", "look -90 0", timeout=30)
    cmd(f"tp {P} 5000.5 230 10.5 -90 0")
    client(".toggle elytra_tweaks on", ".toggle elytra_fly on", "wait 120", ".toggle elytra_fly off", "look -90 25", "wait 200", ".toggle elytra_tweaks off", "wait 10",
        timeout=90)
    x, y, _ = position()
    hp = health()
    # Dying puts you back at spawn, at full health: only a landing out here counts.
    return hp >= 20 and y < 152 and x > 5000, f"landed at y={y:.1f} after {x - 5000:.0f} blocks, health {hp:.1f}"


def recast_highway(*setup, end=4400):
    """A 3-wide obsidian highway at y=200 from x=4000 to `end`, the tester on it facing east, then `setup` commands."""
    client("respawn", ".panic", "wait 20")
    cmd(f"forceload add 3990 -8 {end} 8")
    cmd(f"tp {P} 4000.5 201 0.5 -90 0")
    time.sleep(1.5)
    # In pieces: a fill takes at most 32768 blocks.
    for x in range(3990, end, 400):
        cmd(f"fill {x} 200 -3 {min(x + 399, end)} 206 3 air", f"fill {x} 200 -1 {min(x + 399, end)} 200 1 obsidian")
    cmd(f"clear {P}", f"gamemode survival {P}", f"effect clear {P}",
        f"effect give {P} saturation 1 20 true", f"item replace entity {P} armor.chest with elytra", f"tp {P} 4000.5 201 0.5 -90 0", *setup)
    time.sleep(1)
    # Grim's opinion of the setup (teleporting you mid-move) isn't the module's: count flags from here.
    sh("flags", "mark")


def t_elytra_recast():
    recast_highway()
    client(".set elytra_fly mode recast", ".set elytra_fly obstacles stop", "wait 10", ".toggle elytra_fly on", "wait 200", ".toggle elytra_fly off", "wait 20", timeout=90)
    x, _, z = position()
    return x - 4000 > 200 and abs(z - 0.5) < 0.2, f"{x - 4000:.0f} blocks in 10 s, {abs(z - 0.5):.2f} off the line"


def t_elytra_recast_obstacles():
    # An ender chest and a 2-deep hole in the lane, Clear: past the chest (walked round with Baritone, or mined), and
    # at the hole either stopped before it (no Baritone and no blocks) or across it with Baritone.
    recast_highway("setblock 4150 201 0 ender_chest", "fill 4250 198 -1 4250 200 1 air",
        f"item replace entity {P} hotbar.0 with netherite_pickaxe[enchantments={{efficiency:5}}]")
    client(".set elytra_fly mode recast", ".set elytra_fly obstacles clear", "wait 10", ".toggle elytra_fly on", "wait 400", ".toggle elytra_fly off", "wait 20", timeout=90)
    x, y, _ = position()
    mined = "passed" in cmd("execute if block 4150 201 0 air")
    baritone = has_baritone()
    ok = x > 4160 and y > 200.5 and (x < 4250 or baritone)
    return ok, f"chest {'mined' if mined else 'walked round'}, x={x:.1f} (hole at 4250), y={y:.1f}"


def elytra_damage():
    """The elytra's damage, worn (chest) or swapped off into the hotbar; -1 if it's gone."""
    for slot in ("102b", "0b", "1b", "2b"):
        d = data(f"Inventory[{{Slot:{slot}}}]")
        if "elytra" in d:
            m = re.search(r"damage\"?: (\d+)", d)
            return int(m.group(1)) if m else 0
    return -1


def t_elytra_recast_no_durability():
    # 30 s of bouncing with No Durability: the server's glides must never last the 20 ticks that wear the elytra.
    recast_highway(f"item replace entity {P} hotbar.1 with diamond_chestplate", end=4980)
    client(".set elytra_tweaks no_durability true", ".toggle elytra_tweaks on", ".set elytra_fly mode recast", ".set elytra_fly obstacles stop", "wait 10",
        ".toggle elytra_fly on", "wait 600", ".toggle elytra_fly off", ".toggle elytra_tweaks off", "wait 20", timeout=120)
    x = position()[0]
    damage = elytra_damage()
    return 0 <= damage <= 1 and x - 4000 > 300, f"elytra damage {damage} after {x - 4000:.0f} blocks of bouncing (30 s)"


def t_elytra_recast_diagonal():
    # 2b2t's diagonals: a 3-wide band along x=z. The server misses more landings here, so No Durability's cut matters
    # most; 15 s of bouncing with the chestplate in the main inventory mustn't wear the elytra.
    x0, length = 7000, 500
    client("respawn", ".panic", "wait 20")
    cmd("forceload remove all")
    chunks = {((x0 + i + dx) >> 4, (i + dz) >> 4) for i in range(-8, length + 8) for dx in (-6, 6) for dz in (-6, 6)}
    cmd(*[f"forceload add {cx * 16} {cz * 16}" for cx, cz in chunks])
    cmd(f"tp {P} {x0}.5 201 0.5 -45 0")
    time.sleep(2)
    lane = []
    for i in range(-5, length):
        lane += [f"fill {x0 + i} 200 {i - 4} {x0 + i} 206 {i + 4} air", f"fill {x0 + i} 200 {i - 1} {x0 + i} 200 {i + 1} obsidian"]
    cmd(*lane)
    cmd(f"clear {P}", f"gamemode survival {P}", f"effect clear {P}", f"effect give {P} saturation 1 20 true", f"item replace entity {P} armor.chest with elytra",
        f"item replace entity {P} inventory.5 with diamond_chestplate", f"tp {P} {x0}.5 201 0.5 -45 0")
    time.sleep(1)
    sh("flags", "mark")
    client(".set elytra_tweaks no_durability true", ".toggle elytra_tweaks on", ".set elytra_fly mode recast", ".set elytra_fly obstacles stop", "wait 10",
        ".toggle elytra_fly on", "wait 300", ".toggle elytra_fly off", ".toggle elytra_tweaks off", "wait 20", timeout=90)
    x, y, z = position()
    worn = elytra_damage()
    cmd("forceload remove all")
    return worn == 0 and x - x0 > 200 and y > 200.5, f"elytra damage {worn} after {(x - x0) * 1.414:.0f} blocks of diagonal, {abs(x - x0 - z + 0.5) / 1.414:.2f} off the line"


def has_baritone():
    """Whether the running dev client loaded Baritone (a jar in run/mods)."""
    try:
        log = open(os.path.join(HERE, "..", "..", "run", "logs", "latest.log"), errors="replace").read()
    except OSError:
        return False
    return re.search(r"(?m)^\s*- baritone", log) is not None


def elytras():
    """(slot, damage) of every elytra the tester has, worn (102) or carried."""
    out = []
    for slot in [102] + list(range(36)):
        d = data(f"Inventory[{{Slot:{slot}b}}]")
        if "elytra" in d:
            m = re.search(r"damage\"?: (\d+)", d)
            out.append((slot, int(m.group(1)) if m else 0))
    return out


def t_elytra_recast_spare_elytras():
    # Three spare elytras and the chestplate in the main inventory, Auto Armor wanting an elytra on (as players set it):
    # the same elytra keeps being used, spares stay where they are and don't wear, and nothing warns.
    recast_highway(f"item replace entity {P} inventory.5 with diamond_chestplate", f"item replace entity {P} inventory.10 with elytra",
        f"item replace entity {P} inventory.11 with elytra", f"item replace entity {P} inventory.12 with elytra", end=4980)
    client(".set auto_armor chest elytra", ".set auto_armor await_landing false", ".toggle auto_armor on", ".set elytra_tweaks no_durability true",
        ".toggle elytra_tweaks on", ".set elytra_fly mode recast", ".set elytra_fly obstacles stop", "wait 10", ".toggle elytra_fly on", "wait 400",
        ".toggle elytra_fly off", "wait 40", ".toggle elytra_tweaks off", ".toggle auto_armor off", ".set auto_armor chest chestplate",
        ".set auto_armor await_landing true", timeout=90)
    found = elytras()
    hotbar = [slot for slot, _ in found if slot < 9]
    worn = sum(1 for _, d in found if d > 0)
    x = position()[0]
    return len(hotbar) <= 1 and worn <= 1 and x - 4000 > 300, f"elytras {found}, {len(hotbar)} in the hotbar, {worn} worn; {x - 4000:.0f} blocks"


def t_elytra_recast_full_hotbar():
    # No hotbar slot for the chestplate: No Durability says so once and the bounce carries on (it used to release your
    # keys every tick trying).
    recast_highway(f"item replace entity {P} inventory.5 with diamond_chestplate",
        *[f"item replace entity {P} hotbar.{i} with {item} 64" for i, item in enumerate(["dirt", "cobblestone", "stone", "oak_planks", "glass", "sand", "gravel", "netherrack", "andesite"])])
    client(".set elytra_tweaks no_durability true", ".toggle elytra_tweaks on", ".set elytra_fly mode recast", ".set elytra_fly obstacles stop", "wait 10",
        ".toggle elytra_fly on", "wait 200", ".toggle elytra_fly off", ".toggle elytra_tweaks off", "wait 20", timeout=90)
    x = position()[0]
    # (The warning is a toast, not in the log.) Nothing was clicked: the chestplate is where it was, the hotbar unchanged.
    untouched = item(14) == "minecraft:diamond_chestplate" and item(0) == "minecraft:dirt"
    return untouched and x - 4000 > 200, f"{'inventory untouched' if untouched else 'inventory changed'}, {x - 4000:.0f} blocks in 10 s"


def t_elytra_recast_fill_hole():
    # A 3-deep hole across the lane and no Baritone: Clear fills it at floor level with blocks from the hotbar and bounces on.
    recast_highway("fill 4100 197 -1 4101 200 1 air", f"item replace entity {P} hotbar.2 with obsidian 64")
    client(".set elytra_fly mode recast", ".set elytra_fly obstacles clear", "wait 10", ".toggle elytra_fly on", "wait 400", ".toggle elytra_fly off", "wait 20", timeout=90)
    x, y, _ = position()
    filled = sum(passed(f"if block {bx} 200 {bz} obsidian") for bx in (4100, 4101) for bz in (-1, 0, 1))
    above = sum(passed(f"if block {bx} 201 {bz} obsidian") for bx in range(4095, 4106) for bz in (-1, 0, 1))
    return filled >= 2 and above == 0 and x > 4150 and y > 200.5, f"{filled}/6 hole blocks filled, {above} placed above the floor, x={x:.0f}, y={y:.1f}"


def t_elytra_recast_disconnect():
    # Stop with If Blocked Disconnect: a chest in the lane logs you out (then the tester joins again).
    recast_highway("setblock 4100 201 0 ender_chest")
    client(".set elytra_fly mode recast", ".set elytra_fly obstacles stop", ".set elytra_fly if_blocked disconnect", "wait 10", ".toggle elytra_fly on", "wait 160", timeout=60)
    left = P not in cmd("list")
    client("wait 40", "connect localhost:25565", "wait 100", ".set elytra_fly if_blocked wait", ".set elytra_fly obstacles clear", ".toggle elytra_fly off", timeout=60)
    return left, "disconnected" if left else "still online"


def t_elytra_recast_walk_round():
    # Baritone installed: an ender chest and a bedrock pillar in the lane are walked round (the chest left alone).
    recast_highway("setblock 4100 201 0 ender_chest", "fill 4160 201 0 4160 202 0 bedrock", f"item replace entity {P} hotbar.0 with netherite_pickaxe")
    if not has_baritone(): return True, "skipped: Baritone isn't installed in the dev client (run/mods)"
    client(".set elytra_fly mode recast", ".set elytra_fly obstacles clear", "wait 10", ".toggle elytra_fly on", "wait 500", ".toggle elytra_fly off", "wait 20", timeout=90)
    x, y, _ = position()
    chest = "passed" in cmd("execute if block 4100 201 0 ender_chest")
    return chest and x > 4170 and y > 200.5, f"chest {'left' if chest else 'mined'}, x={x:.0f}, y={y:.1f}"


def t_elytra_recast_back_on_lane():
    # Knocked off the highway (onto a ledge 4 below, beside it) while bouncing: Baritone takes you back up onto the lane
    # at its height, and the bounce goes on.
    recast_highway("fill 4055 195 2 4095 206 9 air", "fill 4060 195 3 4090 195 9 stone", f"item replace entity {P} hotbar.3 with dirt 64")
    if not has_baritone(): return True, "skipped: Baritone isn't installed in the dev client (run/mods)"
    client(".set elytra_fly mode recast", ".set elytra_fly obstacles clear", "wait 10", ".toggle elytra_fly on", "wait 40", timeout=30)
    cmd(f"tp {P} 4075.5 196 6.5")
    # The knock-off is the test's teleport: Grim's take on it isn't the module's.
    client("wait 40", timeout=10)
    time.sleep(1)
    sh("flags", "mark")
    client("wait 560", ".toggle elytra_fly off", "wait 20", timeout=90)
    x, y, z = position()
    return y > 200.5 and x > 4120 and abs(z - 0.5) < 1.5, f"x={x:.0f}, y={y:.1f}, {abs(z - 0.5):.1f} off the line"


def t_elytra_recast_low_ceiling():
    # Turned on under a two-high roof: it walks out from under it (mining nothing) and bounces on from there.
    recast_highway("fill 3995 203 -1 4030 203 1 stone", f"item replace entity {P} hotbar.0 with netherite_pickaxe[enchantments={{efficiency:5}}]")
    client(".set elytra_fly mode recast", ".set elytra_fly obstacles clear", "wait 10", ".toggle elytra_fly on", "wait 300", ".toggle elytra_fly off", "wait 20", timeout=90)
    x = position()[0]
    roof = sum(passed(f"if block {bx} 203 0 stone") for bx in range(3995, 4031))
    return roof == 36 and x > 4150, f"{x - 4000:.0f} blocks in 15 s, {36 - roof} roof blocks mined"


def damage(slot):
    """The damage of the item in an inventory slot number as the server stores it; -1 if empty."""
    d = data(f"Inventory[{{Slot:{slot}b}}]")
    if not d: return -1
    m = re.search(r"damage\"?: (\d+)", d)
    return int(m.group(1)) if m else 0


def t_no_break_tools():
    # A pickaxe with 6 uses left in hand and a fresh one in the inventory: they swap places.
    reset()
    cmd(f"item replace entity {P} hotbar.0 with netherite_pickaxe[damage=2025]", f"item replace entity {P} inventory.5 with diamond_pickaxe")
    client("select 1", ".set no_break tools true", ".toggle no_break on", "wait 20")
    swapped = item(0) == "minecraft:diamond_pickaxe" and item(14) == "minecraft:netherite_pickaxe"
    # Now with nothing to swap in: it's put away, and mining (Packet Mine picks the tool) leaves it there.
    cmd(f"clear {P}", f"item replace entity {P} hotbar.0 with netherite_pickaxe[damage=2025]", "setblock 1003 100 0 dirt")
    client("wait 20", ".toggle packet_mine on", "look -90 20.47", "wait 2", "attack", "wait 40", ".toggle packet_mine off", ".toggle no_break off")
    spared = item(0) == "" and item(9) == "minecraft:netherite_pickaxe" and damage(9) == 2025
    mined = passed("if block 1003 100 0 air")
    return swapped and spared and mined, f"{'swapped' if swapped else 'not swapped'}; alone: {'put away and left alone' if spared else f'slot 0 {item(0)}, damage {damage(9)}'}, dirt {'mined' if mined else 'not mined'}"


def t_no_break_armor():
    # A chestplate with 8 uses left and a better one carried: swapped. Leggings with 5 left and none spare: taken off.
    # Auto Armor, also on, must not put them back.
    reset()
    cmd(f"item replace entity {P} armor.chest with diamond_chestplate[damage=520]", f"item replace entity {P} armor.legs with diamond_leggings[damage=490]",
        f"item replace entity {P} inventory.5 with netherite_chestplate")
    client(".toggle auto_armor on", ".toggle no_break on", "wait 40", ".toggle no_break off", ".toggle auto_armor off")
    chest, legs = item(102), item(101)
    ok = chest == "minecraft:netherite_chestplate" and legs == ""
    return ok, f"chest {chest or 'empty'}, legs {legs or 'empty'}"


def t_no_break_elytra():
    # Flying with an elytra 12 uses from wearing out and a fresh one carried: swapped in mid-air, still flying.
    client("respawn", ".panic", "wait 20")
    cmd(f"clear {P}", f"gamemode survival {P}", f"item replace entity {P} armor.chest with elytra[damage=420]", f"item replace entity {P} inventory.5 with elytra",
        f"tp {P} 6000.5 230 0.5 -90 0")
    time.sleep(1.5)
    sh("flags", "mark")
    client(".set elytra_fly mode altitude", ".toggle elytra_fly on", "wait 20", ".toggle no_break on", "wait 40", "status", ".toggle no_break off", ".toggle elytra_fly off",
        timeout=60)
    y = position()[1]
    worn, spare = damage(102), damage(14)
    # The fresh one wears a point a second for the rest of the flight.
    return 0 <= worn <= 3 and 420 <= spare <= 422 and y > 120, f"worn elytra damage {worn}, put away {spare}, y={y:.0f}"


def t_elytra_wearing_out():
    # Altitude with an elytra that won't last the flight (102 uses left, 225 blocks up, no No Durability): it has to come
    # down and land before it breaks, not fall when it does.
    client("respawn", ".panic", "wait 20")
    cmd(f"clear {P}", f"gamemode survival {P}", f"effect clear {P}", f"effect give {P} instant_health 1 5 true",
        f"item replace entity {P} armor.chest with elytra[damage=330]")
    client(".set elytra_fly mode altitude", "look -90 0", timeout=30)
    cmd(f"tp {P} 7000.5 300 0.5 -90 0")
    client(".toggle elytra_fly on", "wait 1400", ".toggle elytra_fly off", timeout=120)
    x, y, _ = position()
    hp = health()
    wear = re.search(r"damage\": (\d+)", data("Inventory[{Slot:102b}]"))
    return hp >= 20 and x > 7000, f"landed at y={y:.0f} after {x - 7000:.0f} blocks, health {hp:.0f}, elytra damage {wear.group(1) if wear else '?'} of 432"


def online():
    return P in cmd("list")


def rejoin():
    client("connect localhost:25565", timeout=10)
    for _ in range(60):
        if online():
            time.sleep(3)
            return True
        time.sleep(1)
    return False


def leaves_within(seconds):
    end = time.time() + seconds
    while time.time() < end:
        if not online():
            return True
        time.sleep(0.1)
    return False


def t_auto_disconnect():
    # Leaves on a hit below the health threshold, and next to a charged respawn anchor that could kill you (its blast
    # reaches you once the anchor's gone, which the danger maths has to know); rejoins after each.
    reset()
    ads = [f".set auto_disconnect {t} false" for t in ("totem_pops", "totems_left", "armor", "players", "beds", "crystals", "creepers")]
    client(*ads, ".set auto_disconnect health true", ".set auto_disconnect threshold 6", ".set auto_disconnect anchors false",
        ".set auto_disconnect after_leaving turn_off", ".toggle auto_disconnect on", "wait 10")
    cmd(f"damage {P} 15")
    hurt = leaves_within(3)
    if not rejoin(): return False, "couldn't rejoin"
    reset()
    cmd("setblock 1003 100 0 respawn_anchor[charges=4]")
    client(".set auto_disconnect health false", ".set auto_disconnect anchors true", ".toggle auto_disconnect on", "wait 10")
    anchor = leaves_within(3)
    if not rejoin(): return False, "couldn't rejoin"
    cmd("setblock 1003 100 0 air")
    client(".set auto_disconnect health true", ".toggle auto_disconnect off")
    return hurt and anchor, f"left at low health: {hurt}, left next to a charged anchor: {anchor}"


